{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bili (Rust)",
  "version": "0.1.0",
  "identifier": "dev.local.bili-rust",
  "build": {
    "beforeDevCommand": "cd ui && trunk serve --port 1420",
    "beforeBuildCommand": "bash scripts/build-ui.sh",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bili (Rust)",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http: biliimg:; media-src 'self' bilistream: blob: data:; connect-src 'self' ipc: http://ipc.localhost https: http: bilistream: biliimg: data: blob:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Bilibili desktop client built with Tauri + Leptos",
    "longDescription": "A native desktop client for Bilibili written in Rust using Tauri 2 and a Leptos WASM frontend. Plays DASH streams, renders danmaku, and supports like/coin/favorite/follow actions and QR-code login.",
    "homepage": "https://github.com/chanmaoganda/bili-rust",
    "publisher": "bili-rust",
    "copyright": "Copyright (c) 2026 Ethan Wang",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "video",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"],
        "release": "1",
        "epoch": 0
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
